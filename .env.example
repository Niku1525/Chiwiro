# Copiá este archivo como .env y completá los valores.
# El .env real NUNCA se sube al repo (está en .gitignore).

# Obligatorio: token del bot (Discord Developer Portal -> tu app -> Bot).
DISCORD_TOKEN=

# Opcional: si YouTube tira "Sign in to confirm you're not a bot".
# Ruta a un archivo cookies.txt exportado del navegador...
YTDLP_COOKIES_FILE=
# ...o directamente el nombre del navegador donde tenés sesión iniciada
# (chrome, firefox, edge, brave, opera). Se usa uno u otro, no los dos.
YTDLP_COOKIES_BROWSER=

# Opcional: segundos de audio que se acumulan antes de empezar a reproducir.
# Subilo si el arranque suena cortado, bajalo si tarda mucho en arrancar.
PREBUFFER_SECONDS=30

# Opcional: segundos solo en el canal de voz antes de desconectarse.
AUTO_DISCONNECT_SECONDS=120

# Opcional: para links de Spotify (álbumes y playlists los necesitan sí o sí).
# Se sacan de https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opcional: para el comando /lyrics y el botón "📜 Letra".
# Se saca de https://genius.com/api-clients (Client Access Token)
GENIUS_ACCESS_TOKEN=
